# ── Required ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Canonical origin — used for canonical URLs, sitemap.xml, robots.txt, JSON-LD.
# Must be the real production domain; do not leave as placeholder in production.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Optional: enquiry e-mail notifications ────────────────────────────
# When all five are set, a notification email is sent for each enquiry.
# When unset, enquiries are still stored in the database.
CONTACT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
