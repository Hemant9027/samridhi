# Canonical origin — used for canonical URLs, sitemap.xml, robots.txt, JSON-LD.
# Must be the real production domain; do not leave as placeholder in production.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Optional: enquiry e-mail notifications ────────────────────────────
# All five values are required for enquiry submissions to be accepted.
CONTACT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
